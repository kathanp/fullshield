{
  "name": "fullshield",
  "version": "0.1.1",
  "description": "Full-cycle security scanner for Node.js/TypeScript backends: detect, classify, report, notify, fix, prevent.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kathanp/fullshield.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "fullshield": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": "./dist/runtime/index.js",
    "./runtime/express": "./dist/runtime/express.js",
    "./runtime/fastify": "./dist/runtime/fastify.js",
    "./runtime/rasp": "./dist/runtime/rasp.js",
    "./runtime/register": "./dist/runtime/register.js",
    "./runtime/auto": "./dist/runtime/auto.js",
    "./cli": "./dist/cli/index.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "express": "*",
    "fastify": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "templates",
    "rules"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run test/e2e",
    "test:live-ai": "npm run build && node scripts/live-ai.mjs",
    "bench": "node scripts/bench.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:phase": "node scripts/verify.mjs --phase"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.71.2",
    "commander": "^12.1.0",
    "ignore": "^5.3.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.14.0",
    "express": "^4.22.3",
    "globals": "^15.12.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4",
    "zod": "^4.6.7"
  }
}
